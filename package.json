{
  "name": "daily-tech-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "web:dev": "pnpm run --filter=@daily-tech-blog/web dev",
    "web:build": "pnpm run --filter=@daily-tech-blog/web build",
    "web:deploy": "pnpm run --filter=@daily-tech-blog/web deploy",
    "web:lint": "pnpm run --filter=@daily-tech-blog/web lint",
    "web:format:check": "pnpm run --filter=@daily-tech-blog/web format:check",
    "web:format": "pnpm run --filter=@daily-tech-blog/web format",
    "web:typecheck": "pnpm run --filter=@daily-tech-blog/web typecheck",
    "format:check": "prettier . --check",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "catalog:format",
    "lefthook": "catalog:git",
    "prettier": "catalog:format",
    "prettier-plugin-astro": "catalog:format",
    "wrangler": "catalog:cloudflare"
  }
}
